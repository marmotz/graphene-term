# The name of every language in itself, shared by the bundle of every language: it is
# not translated, so that a user can find their language whatever the interface shows.
# The identifier is `language-` followed by the tag of the language.

language-en-US = English (US)
language-en-GB = English (UK)
language-fr = Français
language-fr-CA = Français (Canada)
language-es = Español
language-de = Deutsch
language-it = Italiano
